{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Episteme",
  "version": "0.2.0",
  "identifier": "io.github.jiarong-song233.episteme",
  "build": {
    "frontendDist": "../starting"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "从你的材料里学，只记下你确认过的理解",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/app/": "app/",
      "resources/node/": "node/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
